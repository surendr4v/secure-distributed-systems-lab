NODE_ENV=development
PORT=3000
SERVICE_NAME=api-gateway
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/secure_finance

JWT_ISSUER=secure-finance-auth
JWT_AUDIENCE=secure-finance-clients
JWT_EXPIRES_IN=15m
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-rs256-private-key\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nreplace-with-rs256-public-key\n-----END PUBLIC KEY-----

# Shared secret for service-to-service (mesh) calls. Sent as the `x-service-secret` header
# and validated by the receiving service's guard. Must be at least 32 characters.
INTERNAL_SHARED_SECRET=replace-with-very-long-shared-secret-value
INTERNAL_JWT_SECRET=replace-with-very-long-internal-jwt-secret

AUTH_SERVICE_URL=http://auth-service:3001
TRANSACTION_SERVICE_URL=http://transaction-service:3002
AUDIT_SERVICE_URL=http://audit-service:3003

OTEL_EXPORTER_OTLP_ENDPOINT=
